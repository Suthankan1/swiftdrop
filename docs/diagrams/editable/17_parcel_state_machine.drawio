 policy&#10;Requires explicit lecturer / business approval" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#AE5B61;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="94" y="513" width="400" height="53" as="geometry" /></mxCell><mxCell id="finaldone" value="" style="ellipse;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="1360" y="345" width="25" height="25" as="geometry" /></mxCell><mxCell id="finalfailed" value="" style="ellipse;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="790" y="760" width="25" height="25" as="geometry" /></mxCell><mxCell id="fd" value="" style="ellipse;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#15324F;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="1365" y="350" width="15" height="15" as="geometry" /></mxCell><mxCell id="ff" value="" style="ellipse;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#15324F;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="795" y="765" width="15" height="15" as="geometry" /></mxCell><mxCell id="invariants" value="Guard for every transition: authenticated courier owns active assignment; expected version matches; input evidence meets the agreed stage policy.&#10;DELIVERED and FAILED are terminal for MVP. No cancellation or redelivery transition is invented; futur