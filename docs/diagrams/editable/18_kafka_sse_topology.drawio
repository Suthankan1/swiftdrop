tFamily=Helvetica;fontSize=13;fontColor=#52677C;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="48" y="1150" width="1604" height="30" as="geometry" /></mxCell><mxCell id="delivery" value="Delivery Operations&#10;Atomic status + history + OUTBOX&#10;Authoritative PostgreSQL state" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#15324F;fontStyle=1;fillColor=#E5F5F1;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="165" width="400" height="100" as="geometry" /></mxCell><mxCell id="relay" value="Delivery outbox relay&#10;Ack -&gt; mark published&#10;Retry; duplicates allowed" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#15324F;fontStyle=0;fillColor=#E5F5F1;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="590" y="165" width="355" height="100" as="geometry" /></mxCell><mxCell id="kafka" value="Kafka KRaft&#10;parcel.lifecycle.v1 | key=parcelId&#10;eventId + aggregateVersion + correlationId&#10;Ordering within a partition; not global" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#15324F;fontStyle=1;fillColor=#FFF2DE;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="1080" y="155" width="565" height="118" as="geometry" /></mxCell><mxCell id="label1" value="Pending rows" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="473.58642578125" y="185" width="102.8271484375" height="22" as="geometry" /></mxCell><mxCell id="label2" value="Publish / ack" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="963.31396484375" y="185" width="97.3720703125" height="22" as="geometry" /></mxCell><mxCell id="commsboundary_title" value="COMMUNICATIONS - one business service, independent handlers" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=1;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="52" y="383" width="731" height="26" as="geometry" /></mxCell><mxCell id="notgroup" value="Group: communications.&#10;notifications.v1&#10;Inbox + durable jobs" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#E5F5F1;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="432" width="300" height="88" as="geometry" /></mxCell><mxCell id="hookgroup" value="Group: communications.&#10;webhooks.v1&#10;Inbox + durable jobs" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#E5F5F1;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="430" y="432" width="320" height="88" as="geometry" /></mxCell><mxCell id="email" value="Email / mock SMS adapter&#10;Resolve recipient via owning APIs" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#E8F1FF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="615" width="300" height="72" as="geometry" /></mxCell><mxCell id="hook" value="Signed merchant webhook&#10;Receiver deduplicates eventId" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#E8F1FF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="430" y="615" width="320" height="72" as="geometry" /></mxCell><mxCell id="dlq" value="Malformed / unprocessable event -&gt; event retry + DLQ review.&#10;External job failure -&gt; bounded durable retries, failed-job review. No exactly-once claim." style="shape=note;size=12;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFF2DE;strokeColor=#CCA764;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="721" width="650" height="65" as="geometry" /></mxCell><mxCell id="sseboundary_title" value="DELIVERY TRACKING - replica fan-out target (separate from Nov 1 login build)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=1;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="383" width="776" height="26" as="geometry" /></mxCell><mxCell id="podA" value="Delivery replica A&#10;Group: tracking.&lt;replica-A&gt;&#10;Consumes ALL topic partitions&#10;Authorized SSE connections" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#E5F5F1;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="890" y="432" width="335" height="110" as="geometry" /></mxCell><mxCell id="podB" value="Delivery replica B&#10;Group: tracking.&lt;replica-B&gt;&#10;Consumes ALL topic partitions&#10;Authorized SSE connections" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#E5F5F1;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="1270" y="432" width="335" height="110" as="geometry" /></mxCell><mxCell id="gw" value="Gateway / Ingress&#10;SSE routing + heartbeat" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#E8F1FF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="1125" y="626" width="255" height="75" as="geometry" /></mxCell><mxCell id="label9" value="SSE" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1068.9931640625" y="564" width="46.013671875" height="22" as="geometry" /></mxCell><mxCell id="label10" value="SSE" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1426.9931640625" y="564" width="46.013671875" height="22" as="geometry" /></mxCell><mxCell id="ui" value="React tracking client&#10;Redacted state-only events" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#15324F;fontStyle=0;fillColor=#E8F1FF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="1050" y="880" width="405" height="75" as="geometry" /></mxCell><mxCell id="label11" value="SSE over HTTPS" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1188.54150390625" y="840" width="126.9169921875" height="22" as="geometry" /></mxCell><mxCell id="caveat" value="Each replica has a unique group, so every connection node receives each event.&#10;A single shared tracking group would load-balance events and miss clients.&#10;Target must be proven with two replicas; clean up stale groups and size lag / load.&#10;One Delivery/SSE replica is the simpler non-HA full-flow demo starting point." style="shape=note;size=12;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFF2DE;strokeColor=#CCA764;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="65" y="868" width="805" height="105" as="geometry" /></mxCell><mxCell id="recover" value="Reconnect: canonical REST GET + latest state version; discard stale events.&#10;Fetch-based SSE supports Authorization header; never put JWT in URL.&#10;Rate-limit public tracking; redact addresses, phones and proof.&#10;Ingress: disable buffering, configure timeouts; heartbeats / backpressure." style="shape=note;size=12;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFF2DE;strokeColor=#CCA764;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="895" y="1007" width="740" height="100" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>