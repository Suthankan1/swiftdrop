6;fontColor=#15324F;fontStyle=0;fillColor=#FDEBEC;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="1110" y="380" width="430" height="100" as="geometry" /></mxCell><mxCell id="waitend" value="" style="ellipse;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="1313" y="525" width="24" height="24" as="geometry" /></mxCell><mxCell id="waitenddot" value="" style="ellipse;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#15324F;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="1318" y="530" width="14" height="14" as="geometry" /></mxCell><mxCell id="retry" value="May refresh&#10;and try again?" style="rhombus;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFF2DE;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="1215" y="1170" width="220" height="100" as="geometry" /></mxCell><mxCell id="stopend" value="" style="ellipse;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="1313" y="1380" width="24" height="24" as="geometry" /></mxCell><mxCell id="stopenddot" value="" style="ellipse;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#15324F;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="1318" y="1385" width="14" height="14" as="geometry" /></mxCell><mxCell id="openpolicy" value="DA-01 to DA-04 remain open:&#10;accept / reject / expiry; capacity;&#10;reassignment / override; cancellation;&#10;assignment audit / retry / notification.&#10;No new parcel states or events." style="shape=note;size=12;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFF2DE;strokeColor=#CCA764;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="1150" width="350" height="175" as="geometry" /></mxCell><mxCell id="readyyes" value="[yes]" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="775" y="497" width="80" height="26" as="geometry" /></mxCell><mxCell id="readyno" value="[none / read failed]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="880" y="400" width="210" height="25" as="geometry" /></mxCell><mxCell id="retryno" value="[stop / unresolved]" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1340" y="1305" width="200" height="28" as="geometry" /></mxCell><mxCell id="readyselect" edge="1" parent="1" source="ready" target="select" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeWidth=1.6;strokeColor=#52677C;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="readywait" edge="1" parent="1" source="read