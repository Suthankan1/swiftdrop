 height="42" as="geometry" /></mxCell><mxCell id="subtitle" value="UML-style activity | Authorized GraphQL reads; manual REST assignment; Delivery owns consistency" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#52677C;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="48" y="78" width="1504" height="45" as="geometry" /></mxCell><mxCell id="footer" value="PROPOSED DESIGN | SwiftDrop v1.3 | Nov 1 milestone - not implementation evidence" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#52677C;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="48" y="1450" width="1504" height="30" as="geometry" /></mxCell><mxCell id="start" value="" style="ellipse;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#15324F;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="748" y="145" width="24" height="24" as="geometry" /></mxCell><mxCell id="load" value="Read-only GraphQL via Gateway -&gt; Query API&#10;Authorized gRPC: Delivery queue + workload;&#10;Accounts courier eligibility" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#EFEAFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="510" y="245" width="500" height="95" as="geometry" /></mxCell><mxCell id="select" value="Dispatcher inspects parcel + eligible courier&#10;Manually selects; displayed workload is advisory" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#E8F1FF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="510" y="535" width="500" height="85" as="geometry" /></mxCell><mxCell id="post" value="REST via Gateway -&gt; Delivery&#10;POST /api/v1/assignments (proposed contract)&#10;parcelId + courierId + expectedVersion" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#E5F5F1;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="510" y="675" width="500" height="90" as="geometry" /></mxCell><mxCell id="guard" value="Delivery validates JWT + dispatcher / resource scope&#10;Accounts eligibility via authenticated gRPC&#10;Nonterminal parcel + version + active uniqueness" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#E5F5F1;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="510" y="820" width="500" height="100" as="geometry" /></mxCell><mxCell id="valid" value="Authorized,&#10;eligible, current?" style="rhombus;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFF2DE;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="650" y="990" width="220" height="110" as="geometry" /></mxCell><mxCell id="reject" value="No assignment committed&#10;Wrong role / scope: stop (401 / 403 / 404)&#10;Conflict / ineligible: refresh required&#10;Dependency timeout: fail closed" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#FDEBEC;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="1110" y="975" width="430" height="125" as="geometry" /></mxCell><mxCell id="commit" value="Atomic Delivery assignment + attributable audit&#10;Lock / version guard + unique active parcel binding&#10;Parcel lifecycle status unchanged" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#E5F5F1;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="510" y="1230" width="500" height="95" as="geometry" /></mxCell><mxCell id="end" value="" style="ellipse;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="748" y="1380" width="24" height="24" as="geometry" /></mxCell><mxCell id="enddot" value="" style="ellipse;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#15324F;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="753" y="1385" width="14" height="14" as="geometry" /></mxCell><mxCell id="label8" value="[else]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="958" y="1016" width="65" height="25" as="geometry" /></mxCell><mxCell id="label9" value="[refresh and reselect]" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1355" y="720" width="195" height="30" as="geometry" /></mxCell><mxCell id="yes" value="[all checks pass]" style="text;html=0;whiteSpa