tyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1490.765625" y="654" width="58.46875" height="22" as="geometry" /></mxCell><mxCell id="label15" value="1 : 0..* each zone role" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="992.7646484375" y="628" width="144.470703125" height="21" as="geometry" /></mxCell><mxCell id="identity" value="Keycloak owns credentials / password hashes and its separate identity DB.&#10;Accounts owns business eligibility and merchant approval.&#10;Roles here are profile mappings; JWT role checks plus domain ownership apply.&#10;No passwords or Google tokens in these application tables." style="shape=note;size=12;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFF2DE;strokeColor=#CCA764;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="1005" width="750" height="103" as="geometry" /></mxCell><mxCell id="rates" value="Zone granularity and actual rates must be agreed with the lecturer / business.&#10;Booking validates an unexpired quote and copies its immutable price snapshot.&#10;Delivery never updates Pricing tables; later rate changes do not alter old fees.&#10;Merchant key hash / scopes may be normalized to a credential table in implementation." style="shape=note;size=12;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFF2DE;strokeColor=#CCA764;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="865" y="1005" width="745" height="103" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>