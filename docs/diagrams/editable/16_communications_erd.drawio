&gt; subscriptions&#10;EXT event_id / parcel_id / merchant_id&#10;state_version, signed_payload_digest&#10;status, attempt_count, next_attempt_at&#10;UK (subscription_id,event_id)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="912" y="246" width="461" height="148" as="geometry" /></mxCell><mxCell id="inbox" value="" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#E5F5F1;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="95" y="605" width="485" height="150" as="geometry" /></mxCell><mxCell id="inbox_head" value="CONSUMED_EVENTS / INBOX" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#15324F;fontStyle=1;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="103" y="610" width="469" height="32" as="geometry" /></mxCell><mxCell id="inbox_rows" value="PK (consumer_name,event_id)&#10;EXT parcel_id, merchant_id&#10;event_type, version, received_at&#10;processed / scheduled_at" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="107" y="651" width="461" height="100" as="geometry" /></mxCell><mxCell id="notification" value="" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#15324F;fontStyle=0;fillColor=#E5F5F1;strokeColor=#52677C;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="900" y="605" width="485" height="174" as="geometry" /></mxCell><mxCell id="notification_head" value="NOTIFICATIONS" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#15324F;fontStyle=1;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="908" y="610" width="469" height="32" as="geometry" /></mxCell><mxCell id="notification_rows" value="PK notification_id&#10;EXT event_id / recipient_sub / parcel_id&#10;channel, destination_ref, template&#10;status, attempts, next_attempt_at&#10;UK (event_id,recipient_sub,channel)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="912" y="651" width="461" height="124" as="geometry" /></mxCell><mxCell id="label5" value="1 : 0..* deliveries" style="rounded=0;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=#FFFFFF;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="679.251953125" y="290" width="121.49609375" height="22" as="geometry" /></mxCell><mxCell id="rel" value="INBOX is independent&#10;per consumer group.&#10;Logical event IDs join&#10;job records by lookup;&#10;no FK to Kafka or&#10;Delivery database." style="shape=note;size=12;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFF2DE;strokeColor=#CCA764;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="630" y="580" width="220" height="170" as="geometry" /></mxCell><mxCell id="jobs" value="Processing rule: atomically record consumer receipt + notification / webhook job, then commit Kafka offset. Worker attempts are persisted.&#10;Exhausted retries -&gt; failed job / DLQ review. Signed webhooks carry eventId + state version; receiver deduplicates.&#10;Optional WEBHOOK_ATTEMPTS child table (delivery_id FK) stores attempt timestamps / outcome; no full sensitive response bodies." style="shape=note;size=12;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFF2DE;strokeColor=#CCA764;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="950" width="1375" height="75" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>