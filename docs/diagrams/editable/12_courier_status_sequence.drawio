Cell id="msg4" value="Read pending committed outbox" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.3487141927083" y="455" width="227.96923828125" height="22" as="geometry" /></mxCell><mxCell id="msg5" value="ParcelStatusChanged / eventId / version" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="673.0877278645833" y="511" width="280.4912109375" height="22" as="geometry" /></mxCell><mxCell id="msg6" value="Publish parcel.lifecycle.v1&#10;key=parcelId; await acknowledgement" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="953.7196451822915" y="547" width="265.89404296875" height="42" as="geometry" /></mxCell><mxCell id="msg7" value="Ack; mark published (duplicates possible)" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="942.6857096354165" y="623" width="287.9619140625" height="22" as="geometry" /></mxCell><mxCell id="msg8" value="notifications.v1 and webhooks.v1&#10;Independent consumer groups" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1243.931640625" y="659" width="232.13671875" height="42" as="geometry" /></mxCell><mxCell id="msg9" value="Persist inbox + delivery job first&#10;Then email / signed webhook attempt" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1502.6787923177085" y="715" width="261.30908203125" height="42" as="geometry" /></mxCell><mxCell id="msg10" value="Success / failure response" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1539.3731282552085" y="791" width="187.92041015625" height="22" as="geometry" /></mxCell><mxCell id="note0" value="Kafka outage: outbox remains pending; relay retries. Duplicate publish: consumers deduplicate by (consumer,eventId), then persist jobs before offset commit." style="shape=note;size=12;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFF2DE;strokeColor=#CCA764;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="851" width="1720" height="67" as="geometry" /></mxCell><mxCell id="note1" value="Provider failure: durable backoff retries with attempt logs, then failed job / DLQ review. External side effects remain at-least-once; merchant deduplicates eventId." style="shape=note;size=12;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFF2DE;strokeColor=#CCA764;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="933" width="1720" height="67" as="geometry" /></mxCell><mxCell id="note2" value="PARALLEL: Kafka tracking consumer in Delivery forwards redacted updates through Gateway SSE. Replica fan-out and reconnect recovery appear in diagram 18." style="shape=note;size=12;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFF2DE;strokeColor=#CCA764;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="1015" width="1720" height="67" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>