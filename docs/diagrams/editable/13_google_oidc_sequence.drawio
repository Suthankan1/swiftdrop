rtex="1" parent="1"><mxGeometry x="868.90966796875" y="567" width="322.1806640625" height="22" as="geometry" /></mxCell><mxCell id="msg7" value="Validated identity result" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="946.454833984375" y="623" width="167.09033203125" height="22" as="geometry" /></mxCell><mxCell id="msg8" value="Keycloak code + state callback&#10;via browser redirect" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="561.23388671875" y="659" width="217.5322265625" height="42" as="geometry" /></mxCell><mxCell id="msg9" value="/token: Keycloak code + PKCE verifier" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="537.06396484375" y="735" width="265.8720703125" height="22" as="geometry" /></mxCell><mxCell id="msg10" value="Keycloak access JWT + OIDC ID token" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="533.3359375" y="791" width="273.328125" height="22" as="geometry" /></mxCell><mxCell id="msg11" value="Bearer ACCESS token: profile bootstrap / read" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="868.920654296875" y="847" width="322.15869140625" height="22" as="geometry" /></mxCell><mxCell id="msg12" value="Validate issuer/audience/expiry/signature&#10;Map sub -&gt; profile; role + ownership checks" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=15;fontColor=#15324F;fontStyle=0;fillColor=#FFFFFF;strokeColor=#52677C;strokeWidth=1.5;spacing=10;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="878.92919921875" y="883" width="302.1416015625" height="42" as="geometry" /></mxCell><mxCell id="note0" value="React validates state; OIDC client checks nonce / ID-token claims. PKCE verifier is not sent in the authorization redirect. No client secret in SPA." style="shape=note;size=12;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFF2DE;strokeColor=#CCA764;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="963" width="1520" height="67" as="geometry" /></mxCell><mxCell id="note1" value="Keycloak assigns approved application roles; Google login must not grant courier / dispatcher / admin privileges. Secrets remain server-side." style="shape=note;size=12;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFF2DE;strokeColor=#CCA764;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="1045" width="1520" height="67" as="geometry" /></mxCell><mxCell id="note2" value="API accepts Keycloak access tokens, not Google ID tokens. Handle cancellation / expiry; tokens kept out of URLs and logs. Google provider setup is planned, not verified." style="shape=note;size=12;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#15324F;fontStyle=0;fillColor=#FFF2DE;strokeColor=#CCA764;strokeWidth=1.5;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="1127" width="1520" height="67" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>