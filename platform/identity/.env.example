# ==============================================================================
# Devarom Platform — Keycloak Identity Environment Template (.env.example)
# Safe for version control: contains no secrets, tokens, or private credentials.
# Copy this file to .env and configure your local runtime values.
# ==============================================================================

# Keycloak Bootstrap Administrator (master realm bootstrap on initial startup)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Keycloak PostgreSQL Database (for standalone/production logical database keycloak_db)
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=

# Google OAuth 2.0 Identity Provider Credentials (from Google Cloud Console)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Keycloak Runtime Network & Port Binding
KEYCLOAK_PORT=8090
KC_HOSTNAME=http://localhost:8090

# Local capture-only SMTP (Keycloak resolves mailpit on the Compose network).
# These defaults are non-secret; the runtime upgrade reads them without changing .env.
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@devarom.test
SMTP_FROM_DISPLAY_NAME=Devarom
SMTP_AUTH=false
SMTP_SSL=false
SMTP_STARTTLS=false
# Real providers require TLS, an approved sender and ignored server-side credentials.
SMTP_USER=
SMTP_PASSWORD=
