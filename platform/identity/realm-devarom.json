{
  "id": "devarom",
  "realm": "devarom",
  "displayName": "Devarom Parcel Delivery & Courier Management",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>Devarom</span></div>",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "loginTheme": "devarom",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "defaultRole": {
    "name": "default-roles-devarom",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false,
    "containerId": "devarom"
  },
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Standard customer role for parcel booking, delivery tracking, and profile access",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "MERCHANT",
        "description": "Business client role for batch orders; requires administrative approval in Accounts Service",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "COURIER",
        "description": "Field delivery courier personnel role for updating assigned parcels and recording proof of delivery",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "DISPATCHER",
        "description": "Operational coordinator role for managing courier workload and parcel assignment",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "ADMIN",
        "description": "System administrator role for managing merchant approvals, zones, and platform parameters",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "default-roles-devarom",
        "description": "${role_default-roles}",
        "composite": true,
        "clientRole": false,
        "composites": {
          "realm": [
            "CUSTOMER",
            "offline_access",
            "uma_authorization"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "devarom-frontend",
      "name": "Devarom Frontend SPA",
      "description": "Public OIDC client for React + TypeScript + Vite Single Page Application",
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "http://localhost:5173/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "rootUrl": "http://localhost:5173",
      "baseUrl": "http://localhost:5173",
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "attributes": {
        "oidc.ciba.grant.enabled": "false",
        "post.logout.redirect.uris": "http://localhost:5173/##http://localhost:5173",
        "oauth2.device.authorization.grant.enabled": "false",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "300"
      },
      "protocolMappers": [
        {
          "name": "devarom-audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "",
            "included.custom.audience": "devarom-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "roles-claim-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "multivalued": "true"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": false,
      "updateProfileFirstLoginMode": "on",
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT",
        "useJwksUrl": "true"
      }
    }
  ],
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@devarom.test",
    "fromDisplayName": "Devarom",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  }
}
