{
  "id": "swiftdrop",
  "realm": "swiftdrop",
  "displayName": "SwiftDrop Parcel Delivery & Courier Management",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>SwiftDrop</span></div>",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "loginTheme": "swiftdrop",
  "browserSecurityHeaders": {
    "contentSecurityPolicyReportOnly": "",
    "xContentTypeOptions": "nosniff",
    "xRobotsTag": "none",
    "xFrameOptions": "SAMEORIGIN",
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xXSSProtection": "1; mode=block",
    "strictTransportSecurity": "max-age=31536000"
  },
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpPolicyCodeReusable": false,
  "otpSupportedApplications": [
    "totpAppGoogleName",
    "totpAppMicrosoftAuthenticatorName",
    "totpAppFreeOTPName"
  ],
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "defaultRole": {
    "name": "default-roles-swiftdrop",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false,
    "containerId": "swiftdrop"
  },
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Standard customer role for parcel booking, delivery tracking, and profile access",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "MERCHANT",
        "description": "Business client role for batch orders; requires administrative approval in Accounts Service",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "COURIER",
        "description": "Field delivery courier personnel role for updating assigned parcels and recording proof of delivery",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "DISPATCHER",
        "description": "Operational coordinator role for managing courier workload and parcel assignment",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "ADMIN",
        "description": "System administrator role for managing merchant approvals, zones, and platform parameters",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "default-roles-swiftdrop",
        "description": "${role_default-roles}",
        "composite": true,
        "clientRole": false,
        "composites": {
          "realm": [
            "CUSTOMER",
            "offline_access",
            "uma_authorization"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "swiftdrop-frontend",
      "name": "SwiftDrop Frontend SPA",
      "description": "Public OIDC client for React + TypeScript + Vite Single Page Application",
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "https://swiftdrop.local:18443/auth/callback",
        "https://app.swiftdrop.local:18443/auth/callback",
        "http://localhost:5173/auth/callback"
      ],
      "webOrigins": [
        "https://swiftdrop.local:18443",
        "https://app.swiftdrop.local:18443",
        "http://localhost:5173"
      ],
      "rootUrl": "https://swiftdrop.local:18443",
      "baseUrl": "https://swiftdrop.local:18443",
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "attributes": {
        "oidc.ciba.grant.enabled": "false",
        "post.logout.redirect.uris": "https://swiftdrop.local:18443/##https://swiftdrop.local:18443##https://app.swiftdrop.local:18443/##https://app.swiftdrop.local:18443##http://localhost:5173/##http://localhost:5173",
        "oauth2.device.authorization.grant.enabled": "false",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "300"
      },
      "protocolMappers": [
        {
          "name": "swiftdrop-audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "",
            "included.custom.audience": "swiftdrop-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "roles-claim-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "multivalued": "true"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "delivery-service",
      "name": "Delivery Operations Service",
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "delivery-service-secret-internal",
      "redirectUris": [],
      "webOrigins": [],
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "attributes": {
        "realm_client": "false"
      },
      "authenticationFlowBindingOverrides": {},
      "fullScopeAllowed": true,
      "nodeReRegistrationTimeout": -1,
      "protocolMappers": [
        {
          "name": "api-audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "false",
            "included.custom.audience": "swiftdrop-api",
            "access.token.claim": "true"
          }
        },
        {
          "name": "internal-audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "false",
            "included.custom.audience": "swiftdrop-internal",
            "access.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "service_account",
        "acr",
        "roles",
        "profile",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "organization",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "updateProfileFirstLoginMode": "on",
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT",
        "useJwksUrl": "true"
      }
    }
  ],
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@swiftdrop.test",
    "fromDisplayName": "SwiftDrop",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  }
}
