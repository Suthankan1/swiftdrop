{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Server Request Rate",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "swiftdrop-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(swiftdrop_grpc_server_requests_total[1m]))",
          "legendFormat": "Inbound Calls/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Server Error Rate",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "swiftdrop-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(swiftdrop_grpc_server_errors_total[1m]))",
          "legendFormat": "Inbound Errors/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "errps",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Client Request Rate",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "swiftdrop-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(swiftdrop_grpc_client_requests_total[1m]))",
          "legendFormat": "Outbound Calls/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Deadline Exceeded Spike",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "swiftdrop-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(swiftdrop_grpc_server_errors_total{status=\"DEADLINE_EXCEEDED\"}[5m]))",
          "legendFormat": "Deadlines/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "errps",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 2 }] }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "title": "Server Errors by Status Code",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "swiftdrop-prometheus" },
      "targets": [
        {
          "expr": "sum by (service, status) (rate(swiftdrop_grpc_server_errors_total[1m]))",
          "legendFormat": "{{service}} - {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "errps" } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 6,
      "title": "Client Call Latency (seconds)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "swiftdrop-prometheus" },
      "targets": [
        {
          "expr": "sum by (service, method) (rate(swiftdrop_grpc_client_duration_seconds_sum[5m])) / sum by (service, method) (rate(swiftdrop_grpc_client_duration_seconds_count[5m]))",
          "legendFormat": "{{service}} - {{method}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "s" } }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["swiftdrop", "grpc", "latency"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "SwiftDrop - Internal gRPC Operations",
  "uid": "swiftdrop-grpc",
  "version": 1
}

