      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Oldest Pending Event Age",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "swiftdrop-prometheus" },
      "targets": [
