      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "title": "Outbox Event State Trend",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "swiftdrop-prometheus" },
      "targets": [
        {
          "expr": "swiftdrop_outbox_pending",
          "legendFormat": "Pending",
          "refId": "A"
        },
        {
          "expr": "swiftdrop_outbox_failed",
          "legendFormat": "Failed",
          "refId": "B"
        },
        {
          "expr": "swiftdrop_outbox_dead_letter",
          "legendFormat": "Dead Letter",
