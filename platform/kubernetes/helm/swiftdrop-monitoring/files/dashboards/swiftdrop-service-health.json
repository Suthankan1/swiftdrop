{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Overall Core Service Health",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "swiftdrop-prometheus" },
      "targets": [
        {
          "expr": "min(probe_success{job=\"swiftdrop-readiness\"}) or vector(0)",
          "legendFormat": "All Services Healthy",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN / UNREADY" }, "1": { "color": "green", "text": "ALL READY" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 0 },
      "id": 2,
      "title": "Service Readiness Status (probe_success)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "swiftdrop-prometheus" },
      "targets": [
        {
          "expr": "probe_success{job=\"swiftdrop-readiness\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "pointSize": 5, "showPoints": "auto" },
          "unit": "short",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 3,
      "title": "Telemetry Scrape Target Status (up)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "swiftdrop-prometheus" },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}} - {{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter" },
          "unit": "short",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 4,
      "title": "Readiness Probe Latency (seconds)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "swiftdrop-prometheus" },
      "targets": [
        {
          "expr": "probe_duration_seconds{job=\"swiftdrop-readiness\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "s"
        }
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["swiftdrop", "health", "readiness"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "SwiftDrop - Core Service Health & Readiness",
  "uid": "swiftdrop-service-health",
  "version": 1
}

