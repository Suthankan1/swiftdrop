{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "title": "Active Live SSE Connections",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "swiftdrop-prometheus" },
      "targets": [
        {
          "expr": "sum(swiftdrop_sse_connections_active)",
          "legendFormat": "Active Subscribers",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "title": "Total Rejected Connections",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "swiftdrop-prometheus" },
      "targets": [
        {
          "expr": "sum(swiftdrop_sse_connections_rejected_total)",
          "legendFormat": "Rejected",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "title": "Accepted vs Closed Connection Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "swiftdrop-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(swiftdrop_sse_connections_accepted_total[1m]))",
          "legendFormat": "Accepted/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(swiftdrop_sse_connections_closed_total[1m]))",
          "legendFormat": "Closed/s",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "cps" } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "id": 4,
      "title": "Rejected Connections by Reason (Rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "swiftdrop-prometheus" },
      "targets": [
        {
          "expr": "rate(swiftdrop_sse_connections_rejected_total[1m])",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" }, "unit": "cps" } }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["swiftdrop", "sse", "tracking"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "SwiftDrop - Live Parcel SSE Tracking",
  "uid": "swiftdrop-sse",
  "version": 1
}

