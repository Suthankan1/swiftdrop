# ==============================================================================
# SwiftDrop Platform — Full-Stack Compose Runtime Environment Contract
# Copy to .env for local runtime injection. NEVER commit real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Container Image Pinned Tag Contract (#128)
# ------------------------------------------------------------------------------
# Pinned immutable git commit short SHA tag for approved application images.
SWIFTDROP_IMAGE_TAG=b8ac497

# ------------------------------------------------------------------------------
# 2. Host Loopback Port Bindings (Strict 127.0.0.1)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
GATEWAY_PORT=8080
KEYCLOAK_PORT=8090
MAILPIT_UI_PORT=8025
ACCOUNTS_DB_PORT=5438
KEYCLOAK_DB_PORT=5437
BUSINESS_DB_PORT=5439
KAFKA_PORT=9092
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# 3. Database Credentials & Ownership Boundaries
# ------------------------------------------------------------------------------
# Accounts Service Database (accounts_db)
ACCOUNTS_DB_USERNAME=accounts_app
ACCOUNTS_DB_PASSWORD=replace_with_local_accounts_password

# Business PostgreSQL Server Master & Service Roles (pricing_db, delivery_db, communications_db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_local_postgres_password
PRICING_DB_USERNAME=pricing_app
PRICING_DB_PASSWORD=replace_with_local_pricing_password
DELIVERY_DB_USERNAME=delivery_app
DELIVERY_DB_PASSWORD=replace_with_local_delivery_password
COMMUNICATIONS_DB_USERNAME=communications_app
COMMUNICATIONS_DB_PASSWORD=replace_with_local_communications_password

# Keycloak Identity Database (keycloak_db)
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=replace_with_local_keycloak_password

# ------------------------------------------------------------------------------
# 4. Identity & OIDC Federation Configuration
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_local_keycloak_admin_password
KEYCLOAK_HOSTNAME=http://localhost:8090
KEYCLOAK_ISSUER_URI=http://localhost:8090/realms/swiftdrop
KEYCLOAK_REALM=swiftdrop
JWT_AUDIENCE=swiftdrop-api

# Google Identity Brokering (Optional local federation)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 5. Apache Kafka Event Streaming Configuration
# ------------------------------------------------------------------------------
KAFKA_CLUSTER_ID=4L622nShTUiAnsYh0-X41w
KAFKA_TOPIC_PARCEL_LIFECYCLE=parcel.lifecycle.v1
KAFKA_TOPIC_PARCEL_LIFECYCLE_DLT=parcel.lifecycle.v1.dlt

# ------------------------------------------------------------------------------
# 6. S3-Compatible Private Storage Configuration (MinIO)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=swiftdrop_storage_admin
MINIO_ROOT_PASSWORD=replace_with_local_minio_password
SWIFTDROP_STORAGE_BUCKET=swiftdrop-pod

# ------------------------------------------------------------------------------
# 7. Internal gRPC Inter-Service Communication
# ------------------------------------------------------------------------------
ACCOUNTS_GRPC_PORT=9081
DELIVERY_GRPC_PORT=9082
PRICING_GRPC_PORT=9083
ACCOUNTS_GRPC_DEADLINE_MS=2000
DELIVERY_GRPC_DEADLINE_MS=2000

# ------------------------------------------------------------------------------
# 8. CORS & Browser Origin Configuration
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 9. Volume Overrides (Optional coexistence with legacy volumes)
# ------------------------------------------------------------------------------
# ACCOUNTS_DB_VOLUME=swiftdrop-accounts-postgres-data
# KEYCLOAK_DB_VOLUME=swiftdrop-keycloak-postgres-data
