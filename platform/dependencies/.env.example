# ==============================================================================
# SwiftDrop Platform — Business Dependencies Environment Template (.env.example)
# Safe for version control: contains no real secrets, tokens, or production keys.
# Copy this file to .env and configure local runtime values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Apache Kafka KRaft Broker
# ------------------------------------------------------------------------------
KAFKA_CONTAINER_NAME=swiftdrop-kafka
KAFKA_PORT=9092
# Internal container network bootstrap: kafka:29092
# Host developer machine bootstrap: 127.0.0.1:9092
KAFKA_CLUSTER_ID=4L622nShTUiAnsYh0-X41w
KAFKA_DEFAULT_REPLICATION_FACTOR=1
KAFKA_DEFAULT_PARTITIONS=3

# Approved topic contracts
KAFKA_TOPIC_PARCEL_LIFECYCLE=parcel.lifecycle.v1
KAFKA_TOPIC_PARCEL_LIFECYCLE_DLT=parcel.lifecycle.v1.dlt

# ------------------------------------------------------------------------------
# 2. Business PostgreSQL Database Server (Pricing, Delivery, Communications)
# ------------------------------------------------------------------------------
BUSINESS_DB_CONTAINER_NAME=swiftdrop-business-postgres
# Default port 5439 avoids conflict with Accounts PostgreSQL (5438/5432)
BUSINESS_DB_PORT=5439
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=postgres

# Pricing & Zones database and isolated application role
PRICING_DB_NAME=pricing_db
PRICING_DB_USERNAME=pricing_app
PRICING_DB_PASSWORD=pricing_dev_password

# Delivery Operations database and isolated application role
DELIVERY_DB_NAME=delivery_db
DELIVERY_DB_USERNAME=delivery_app
DELIVERY_DB_PASSWORD=delivery_dev_password

# Communications database and isolated application role
COMMUNICATIONS_DB_NAME=communications_db
COMMUNICATIONS_DB_USERNAME=communications_app
COMMUNICATIONS_DB_PASSWORD=communications_dev_password

# ------------------------------------------------------------------------------
# 3. Private S3-Compatible Object Storage (MinIO)
# ------------------------------------------------------------------------------
MINIO_CONTAINER_NAME=swiftdrop-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=swiftdrop_storage_admin
MINIO_ROOT_PASSWORD=minio_dev_password

# Private Bucket for Proof-of-Delivery photos and delivery receipts
SWIFTDROP_STORAGE_BUCKET=swiftdrop-pod
SWIFTDROP_STORAGE_REGION=us-east-1

# Application credentials for Delivery Operations backend adapter
SWIFTDROP_STORAGE_ACCESS_KEY=swiftdrop_delivery_app
SWIFTDROP_STORAGE_SECRET_KEY=delivery_storage_dev_secret

# ------------------------------------------------------------------------------
# 4. Resource Constraints (Development Defaults)
# ------------------------------------------------------------------------------
KAFKA_MEM_LIMIT=1024m
POSTGRES_MEM_LIMIT=512m
MINIO_MEM_LIMIT=512m
