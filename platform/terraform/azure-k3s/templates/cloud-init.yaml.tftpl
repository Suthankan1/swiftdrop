#cloud-config
# ==============================================================================
# SwiftDrop Azure Linux VM — Cloud-Init Bootstrapping Specification
# Canonical Reference: docs/deployment/OPTIONAL_AZURE_K3S_SPENDING_AUTHORIZATION.md
# Invariant: Pinned K3s engine; host firewall defense-in-depth with CNI forwarding;
# fail-closed storage mount prerequisite; secret-free bootstrap.
# ==============================================================================

package_update: true
package_upgrade: false

packages:
  - curl
  - ca-certificates
  - gnupg
  - jq
  - e2fsprogs
  - ufw
  - iptables

write_files:
  - path: /usr/local/bin/swiftdrop-storage-mount.sh
    permissions: "0755"
    owner: root:root
    content: |
${indent(6, storage_mount_script)}

  - path: /etc/rancher/k3s/config.yaml
    permissions: "0640"
    owner: root:root
    content: |
${indent(6, k3s_config)}

  - path: /usr/local/bin/swiftdrop-bootstrap.sh
    permissions: "0755"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      LOG_FILE="/var/log/swiftdrop-bootstrap.log"
      exec > >(tee -a "$LOG_FILE") 2>&1

      echo "================================================================================"
      echo "          SWIFTDROP AZURE K3S HOST BOOTSTRAP INITIALIZATION                     "
      echo "================================================================================"
      echo "Timestamp: $(date -u +"%Y-%m-%dT%H:%M:%SZ")"

      # 1. Execute persistent storage mount
      echo "--- 1. INITIALIZING PERSISTENT DATA DISK ---"
      if ! /usr/local/bin/swiftdrop-storage-mount.sh; then
        echo "FATAL: Persistent data disk initialization failed! Halting bootstrap to prevent data corruption." >&2
        touch /var/run/swiftdrop-bootstrap.failed
        exit 1
      fi
      echo "✓ Persistent data disk initialized."

      # 2. Append Private & Public IPs to K3s config TLS SANs
      echo "--- 2. CONFIGURING K3S TLS SANS ---"
      PRIVATE_IP=$(hostname -I | awk '{print $1}')
      if [ -n "$PRIVATE_IP" ]; then
        if ! grep -q "$PRIVATE_IP" /etc/rancher/k3s/config.yaml; then
          echo "  - \"$PRIVATE_IP\"" >> /etc/rancher/k3s/config.yaml
        fi
        echo "✓ Added private IP $PRIVATE_IP to K3s TLS SANs."
      fi

      PUBLIC_IP=$(curl -s -m 5 -H Metadata:true --noproxy "*" "http://169.254.169.254/metadata/instance/network/interface/0/ipv4/ipAddress/0/publicIpAddress?api-version=2021-02-01&format=text" 2>/dev/null || echo "")
      if [ -n "$PUBLIC_IP" ] && [ "$PUBLIC_IP" != "null" ]; then
        if ! grep -q "$PUBLIC_IP" /etc/rancher/k3s/config.yaml; then
          echo "  - \"$PUBLIC_IP\"" >> /etc/rancher/k3s/config.yaml
        fi
        echo "✓ Added public IP $PUBLIC_IP to K3s TLS SANs."
      fi

      # 3. Configure host firewall (UFW) with CNI support
      echo "--- 3. CONFIGURING HOST FIREWALL (UFW) ---"
      if [ -f /etc/default/ufw ]; then
        sed -i 's/DEFAULT_FORWARD_POLICY="DROP"/DEFAULT_FORWARD_POLICY="ACCEPT"/' /etc/default/ufw
      fi

      ufw --force reset
      ufw default deny incoming
      ufw default allow outgoing

      ufw allow in on lo comment 'Allow loopback'
      ufw allow in on cni0 comment 'Allow K3s CNI bridge'
      ufw allow in on flannel.1 comment 'Allow K3s Flannel overlay'
      ufw allow from 10.42.0.0/16 comment 'Allow K3s pod network'
      ufw allow from 10.43.0.0/16 comment 'Allow K3s service network'
      ufw allow 8472/udp comment 'Allow Flannel VXLAN'

%{ for cidr in allowed_ssh_cidrs ~}
      ufw allow from ${cidr} to any port 22 proto tcp comment 'Restricted SSH'
%{ endfor ~}

      ufw allow 443/tcp comment 'HTTPS Ingress'
%{ if enable_http ~}
      ufw allow 80/tcp comment 'HTTP Ingress'
%{ endif ~}

      ufw --force enable
      echo "✓ Host firewall active with CNI allowances."

      # 4. Install pinned K3s engine
      echo "--- 4. INSTALLING K3S (${k3s_version}) ---"
      if ! curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="${k3s_version}" sh -; then
        echo "FATAL: K3s installation failed!" >&2
        touch /var/run/swiftdrop-bootstrap.failed
        exit 1
      fi

      systemctl enable k3s
      systemctl start k3s

      # 5. Await node readiness
      echo "--- 5. AWAITING NODE READINESS ---"
      if ! timeout 180 bash -c 'until k3s kubectl get node 2>/dev/null | grep -q "Ready"; do sleep 5; done'; then
        echo "FATAL: K3s node readiness timed out after 180 seconds!" >&2
        touch /var/run/swiftdrop-bootstrap.failed
        exit 1
      fi

      # 6. Verify storage mount requirement is enforced
      if [ ! -f /mnt/swiftdrop-data/.swiftdrop-data-disk-active ]; then
        echo "FATAL: Storage canary missing from /mnt/swiftdrop-data!" >&2
        touch /var/run/swiftdrop-bootstrap.failed
        exit 1
      fi

      touch /var/run/swiftdrop-bootstrap.complete
      echo "================================================================================"
      echo "✓ SwiftDrop K3s bootstrap completed successfully at $(date -u)"
      echo "================================================================================"

runcmd:
  - /usr/local/bin/swiftdrop-bootstrap.sh
