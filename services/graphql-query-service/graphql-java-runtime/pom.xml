<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.swiftdrop</groupId><artifactId>graphql-query-build</artifactId><version>0.0.1-SNAPSHOT</version><relativePath>..</relativePath></parent>
  <groupId>com.graphql-java</groupId><artifactId>graphql-java</artifactId><version>25.0-swiftdrop-guava33.7.2</version>
  <name>GraphQL Java 25.0 with patched bundled Guava</name>
  <description>Rebuild of the unmodified official 25.0 sources with Guava 33.7.2-jre for CVE-2026-102554.</description>
  <licenses><license><name>MIT</name><url>https://github.com/graphql-java/graphql-java/blob/v25.0/LICENSE.md</url></license></licenses>
  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <graphql-java.upstream.version>25.0</graphql-java.upstream.version>
    <graphql-java.sources.sha256>23ebdef82e9185a18efefa998c1f6a983daafd6500f9018ffcfd214fc5c19bef</graphql-java.sources.sha256>
  </properties>
  <dependencies>
    <dependency><groupId>com.google.guava</groupId><artifactId>guava</artifactId></dependency>
    <dependency><groupId>org.antlr</groupId><artifactId>antlr4-runtime</artifactId><version>4.13.2</version></dependency>
    <dependency><groupId>com.graphql-java</groupId><artifactId>java-dataloader</artifactId><version>6.0.0</version></dependency>
    <dependency><groupId>org.reactivestreams</groupId><artifactId>reactive-streams</artifactId></dependency>
    <dependency><groupId>org.jspecify</groupId><artifactId>jspecify</artifactId><version>1.0.0</version></dependency>
  </dependencies>
  <build>
    <sourceDirectory>${project.build.directory}/generated-sources/graphql-java</sourceDirectory>
    <resources>
      <resource><directory>${project.build.directory}/generated-sources/graphql-java</directory><excludes><exclude>**/*.java</exclude><exclude>META-INF/**</exclude></excludes></resource>
      <resource><directory>${project.build.directory}/upstream-license</directory></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.10.0</version>
        <executions>
          <execution><id>fetch-official-source-release</id><phase>generate-sources</phase><goals><goal>copy</goal></goals><configuration><artifactItems>
            <artifactItem><groupId>com.graphql-java</groupId><artifactId>graphql-java</artifactId><version>${graphql-java.upstream.version}</version><classifier>sources</classifier><outputDirectory>${project.build.directory}/upstream</outputDirectory><destFileName>graphql-java-sources.jar</destFileName></artifactItem>
          </artifactItems></configuration></execution>
          <execution><id>preserve-upstream-license</id><phase>generate-resources</phase><goals><goal>unpack</goal></goals><configuration><artifactItems>
            <artifactItem><groupId>com.graphql-java</groupId><artifactId>graphql-java</artifactId><version>${graphql-java.upstream.version}</version><includes>LICENSE.md</includes><outputDirectory>${project.build.directory}/upstream-license</outputDirectory></artifactItem>
          </artifactItems></configuration></execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-antrun-plugin</artifactId><version>3.2.0</version>
        <executions><execution><id>verify-and-extract-official-sources</id><phase>generate-sources</phase><goals><goal>run</goal></goals><configuration><target>
          <checksum file="${project.build.directory}/upstream/graphql-java-sources.jar" algorithm="SHA-256" property="upstream.sources.sha256"/>
          <fail message="Official GraphQL Java sources failed the pinned SHA-256 verification."><condition><not><equals arg1="${upstream.sources.sha256}" arg2="${graphql-java.sources.sha256}"/></not></condition></fail>
          <unzip src="${project.build.directory}/upstream/graphql-java-sources.jar" dest="${project.build.directory}/generated-sources/graphql-java"/>
        </target></configuration></execution></executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId>
        <configuration><archive><manifestEntries>
          <Automatic-Module-Name>com.graphqljava</Automatic-Module-Name>
          <X-Upstream-Version>${graphql-java.upstream.version}</X-Upstream-Version>
          <X-Upstream-Source-SHA256>${graphql-java.sources.sha256}</X-Upstream-Source-SHA256>
        </manifestEntries></archive></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.0</version>
        <executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
          <createDependencyReducedPom>false</createDependencyReducedPom>
          <artifactSet><includes><include>com.google.guava:guava</include><include>com.google.guava:failureaccess</include><include>org.antlr:antlr4-runtime</include></includes></artifactSet>
          <relocations>
            <relocation><pattern>com.google.common</pattern><shadedPattern>graphql.com.google.common</shadedPattern></relocation>
            <relocation><pattern>org.antlr.v4.runtime</pattern><shadedPattern>graphql.org.antlr.v4.runtime</shadedPattern></relocation>
          </relocations>
          <filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude></excludes></filter></filters>
        </configuration></execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
