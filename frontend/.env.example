# ==============================================================================
# SwiftDrop Frontend Single Page Application (SPA) Environment Template
# Safe for version control: contains no secrets, tokens, or private credentials.
# Vite exposes variables prefixed with VITE_ to the browser client.
# ==============================================================================

# Keycloak Identity Server Base URL & OIDC Realm
VITE_KEYCLOAK_URL=http://localhost:8090
VITE_KEYCLOAK_REALM=swiftdrop
VITE_KEYCLOAK_CLIENT_ID=swiftdrop-frontend

# Spring Cloud API Gateway Base URL
VITE_API_GATEWAY_URL=http://localhost:8080

